# Leave empty in dev: the app calls the RELATIVE base /vulkan/api/v1 (same-origin),
# and the Vite dev proxy forwards /vulkan to the backend so httpOnly cookies work
# without CORS. Set to an absolute API origin only for a non-proxied/prod build
# (which then needs credentialed CORS server-side).
VITE_API_URL=

# Backend origin the Vite dev proxy forwards /vulkan to.
API_PROXY_TARGET=http://localhost:3300
