#Root Admin Credentials
ROOT_PASSWORD=
ROOT_EMAIL=root@vulkan.com

# Node environment: development | test | production
NODE_ENV=development

# Backend server port
SERVER_PORT=3300

# DB credentials and variables
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional full connection string (overrides DB_* parts when set)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Secrets for signing sessions and cookies
SESSION_SECRET=
COOKIES_SECRET=

# Gmail App Credentials
EMAIL_APP_TOKEN=
EMAIL_APP_ADDRESS=

# SMTP transport (defaults target Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Redis (BullMQ queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379